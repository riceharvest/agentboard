#!/usr/bin/env bash
# pre-push hook: scan ONLY the commits being pushed, never the whole history.
#
# Range per ref:
#   - update (remote ref exists): remote_sha..local_sha
#   - new branch/ref:             local_sha --not --remotes=<remote>
#     (commits already reachable from the remote's tracking refs are NOT re-scanned;
#      if the remote has no tracking refs yet, everything reachable is genuinely new)
#   - delete:                     skipped
#
# Checks on the outgoing commits:
#   1. commit messages must not carry AI attribution trailers (Co-Authored-By naming
#      an AI model/tool). The commit-msg hook strips these at commit time; this is the
#      backstop for commits made with --no-verify or imported from elsewhere.
#   2. optional: added lines must not match a forbidden-content regex.
#
# Configuration (env wins over git config):
#   hygiene.aiPattern        / GIT_HYGIENE_AI_PATTERN        AI-name regex (replaces default)
#   hygiene.forbiddenPattern / GIT_HYGIENE_FORBIDDEN_PATTERN added-line guard regex (off if unset)
#
# Install: copy/symlink into .git/hooks/pre-push (chmod +x), or set
#   git config core.hooksPath hooks   (note: hooksPath replaces ALL hooks in .git/hooks).
set -euo pipefail
remote="${1:-origin}"
ZERO=0000000000000000000000000000000000000000

ai_pattern="${GIT_HYGIENE_AI_PATTERN:-$(git config --get hygiene.aiPattern || true)}"
ai_pattern="${ai_pattern:-claude|anthropic|openai|chatgpt|gpt-[0-9]|codex|gemini|copilot|cursor|aider|devin|qwen|deepseek|llama|mistral|🤖}"
forbidden="${GIT_HYGIENE_FORBIDDEN_PATTERN:-$(git config --get hygiene.forbiddenPattern || true)}"

status=0
while read -r lref lsha rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue  # deleting a ref pushes nothing
  if [ "$rsha" = "$ZERO" ]; then
    # New ref: exclude everything the remote already has. Fall back to all remotes
    # when pushed by URL or when this remote has no tracking refs.
    if [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote")" ]; then
      commits=$(git rev-list "$lsha" --not --remotes="$remote")
    else
      commits=$(git rev-list "$lsha" --not --remotes)
    fi
  else
    commits=$(git rev-list "$rsha..$lsha")
  fi
  for c in $commits; do
    msg=$(git log -1 --format=%B "$c")
    if printf '%s\n' "$msg" | grep -iE "^[[:space:]]*co-authored-by:.*($ai_pattern)" >/dev/null 2>&1; then
      echo "pre-push BLOCKED: commit $c carries an AI co-author trailer; amend/rebase it away."
      status=1
    fi
    if [ -n "$forbidden" ]; then
      added=$(git show --format= --unified=0 "$c" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
      if [ -n "$added" ]; then
        m=$(printf '%s\n' "$added" | grep -iE -n "$forbidden" || true)
        if [ -n "$m" ]; then
          echo "pre-push BLOCKED: commit $c adds forbidden content:"
          printf '%s\n' "$m" | head -n 10
          status=1
        fi
      fi
    fi
  done
done
exit "$status"